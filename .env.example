
# ── Meta / Facebook Ads ──────────────────────────────────────────────────────
# Pixel ID from Meta Events Manager. PUBLIC by design — it ships in the browser
# bundle, which is how a pixel works. Leave unset and no Meta code loads at all.
#
# NOTE: this is a STATIC EXPORT — NEXT_PUBLIC_* values are baked in at BUILD
# time, so changing this needs a rebuild + redeploy, not just a restart.
NEXT_PUBLIC_META_PIXEL_ID=
